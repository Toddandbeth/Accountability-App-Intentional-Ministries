# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never prefix with NEXT_PUBLIC_. Used solely by
# src/app/api/cron/keepalive/route.ts (the weekly Vercel Cron job in
# vercel.json that keeps a free-tier Supabase project from auto-pausing).
# From Project Settings -> API -> service_role. Set this in Vercel's
# Environment Variables for Production, not just here locally.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional but recommended — protects the cron endpoint above from being
# triggered by anyone who finds the URL. Vercel automatically sends this
# as a Bearer token when it invokes a Cron Job, if this var is set in the
# project. Any random long string works; generate one and set it in
# Vercel's Environment Variables (Production).
CRON_SECRET=
